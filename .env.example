# Winter Arc V0 — database
#
# Local (default): leave both unset. The app uses file SQLite via node:sqlite
# at data/winterarc.db (or WINTERARC_SQLITE_PATH if you override it).
#
# Production (Turso / libSQL): set BOTH of the following. Do not set only one.
# Never commit real credentials. Do not invent Turso values.
#
# TURSO_DATABASE_URL=libsql://YOUR-DB.turso.io
# TURSO_AUTH_TOKEN=YOUR_TOKEN

# Optional local SQLite path override (tests use this)
# WINTERARC_SQLITE_PATH=data/winterarc.db
